{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5080",

  "ApControl": {
    "Mode": "Simulated",

    "Control": {
      "MaxParallel": 16,
      "BootTimeoutSeconds": 240,
      "MatchmakingTimeoutSeconds": 180,
      "StateTimeoutSeconds": 60,
      "InstallTimeoutSeconds": 1800,
      "StatusPollSeconds": 2,
      "HeartbeatSeconds": 5,
      "DefaultProfile": "Standard"
    },

    "Simulation": {
      "ClientCount": 32,
      "DelayScale": 1.0,
      "FailureRate": 0.05,
      "CrashRate": 0.0005
    },

    "Game": { "Port": 4711, "TimeoutSeconds": 5 },

    "Clients": [],

    "Experiences": [
      { "Id": "conquest", "Name": "Conquest" },
      { "Id": "breakthrough", "Name": "Breakthrough" },
      { "Id": "rush", "Name": "Rush" },
      { "Id": "tdm", "Name": "Team Deathmatch" }
    ],

    "Profiles": [ "Standard", "Aggressive", "Passive", "Objective" ],

    "Workflows": [
      {
        "Name": "Prepare Conquest",
        "Description": "Launch → Join Conquest → Deploy → Start Autoplayer",
        "Steps": [
          { "Action": "Launch" },
          { "Action": "Join", "ExperienceId": "conquest" },
          { "Action": "Deploy" },
          { "Action": "StartAutoplayer", "Profile": "Standard" }
        ]
      },
      {
        "Name": "Swap to Breakthrough",
        "Description": "Leave → Join Breakthrough → Deploy → Start Autoplayer",
        "Steps": [
          { "Action": "SwitchExperience", "ExperienceId": "breakthrough" },
          { "Action": "Deploy" },
          { "Action": "StartAutoplayer", "Profile": "Standard" }
        ]
      },
      {
        "Name": "End of playtest",
        "Description": "Stop autoplay and close the game so no MTBF data is generated in FE",
        "Steps": [
          { "Action": "Stop" }
        ]
      }
    ],

    "Builds": {
      "Provider": "Static",
      "Static": [
        {
          "Id": "qv-latest",
          "Version": "CL1234567",
          "Branch": "QV",
          "Packages": {
            "Xbox": "\\\\buildshare\\qv\\CL1234567\\Xbox\\Game.xvc",
            "PS5": "\\\\buildshare\\qv\\CL1234567\\PS5\\Game.pkg"
          }
        }
      ],
      "Folder": {
        "Root": "\\\\buildshare\\qv",
        "Branch": "QV",
        "PackagePattern": { "Xbox": "Xbox\\*.xvc", "PS5": "PS5\\*.pkg" }
      },
      "BuildBuddy": {
        "BaseUrl": "",
        "BuildsPath": "/api/builds",
        "Branch": "QV"
      }
    },

    "Platforms": {
      "Xbox": {
        "AppId": "REPLACE_WITH_AUMID!Game",
        "DefaultLaunchArgs": "-autoplayer",
        "Cli": {
          "Ping":      { "FileName": "xbconnect", "Arguments": "{address} /QG", "TimeoutSeconds": 10 },
          "Install":   { "FileName": "xbapp", "Arguments": "install /x:{address} \"{packagePath}\"", "TimeoutSeconds": 1800 },
          "Launch":    { "FileName": "xbapp", "Arguments": "launch /x:{address} {appId} {args}", "TimeoutSeconds": 60 },
          "Terminate": { "FileName": "xbapp", "Arguments": "terminate /x:{address} {appId}", "TimeoutSeconds": 60 },
          "Reboot":    { "FileName": "xbreboot", "Arguments": "/x:{address}", "TimeoutSeconds": 60 }
        }
      },
      "PS5": {
        "AppId": "REPLACE_WITH_TITLE_ID",
        "DefaultLaunchArgs": "-autoplayer",
        "Cli": {
          "Ping":      { "FileName": "prospero-ctrl", "Arguments": "target info {address}", "TimeoutSeconds": 10 },
          "Install":   { "FileName": "prospero-ctrl", "Arguments": "package install \"{packagePath}\" /target:{address}", "TimeoutSeconds": 1800 },
          "Launch":    { "FileName": "prospero-ctrl", "Arguments": "application launch {appId} {args} /target:{address}", "TimeoutSeconds": 60 },
          "Terminate": { "FileName": "prospero-ctrl", "Arguments": "application kill /target:{address}", "TimeoutSeconds": 60 },
          "Reboot":    { "FileName": "prospero-ctrl", "Arguments": "power reboot /target:{address}", "TimeoutSeconds": 60 }
        }
      }
    }
  }
}
